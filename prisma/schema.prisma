generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Class {
  id       String         @id @default(uuid())
  name     String         @unique
  students Registration[]
}

model Subject {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  sessions    SessionSubject[]
}

model Tutor {
  id          String         @id @default(uuid())
  name        String
  phoneNumber String?
  sessions    TutorSession[]
}

model SessionInstance {
  id            String           @id @default(uuid())
  date          DateTime
  slotName      String
  startTime     String
  endTime       String
  tutors        TutorSession[]
  subjects      SessionSubject[]
  registrations Registration[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model TutorSession {
  id        String   @id @default(uuid())
  sessionId String
  date      DateTime
  tutorId   String

  tutor   Tutor           @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  session SessionInstance @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, date, tutorId])
}

model SessionSubject {
  id        String   @id @default(uuid())
  sessionId String
  date      DateTime
  subjectId String

  subject Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  session SessionInstance @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, date, subjectId])
}

model Registration {
  id String @id @default(uuid())

  name   String
  materi String?
  date   DateTime

  classId   String
  sessionId String

  class   Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  session SessionInstance @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
